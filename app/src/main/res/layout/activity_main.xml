<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Garage Level Lab"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="TRACKING STOPPED"
            android:textSize="28sp"
            android:textStyle="bold"
            android:background="@drawable/panel_background" />

        <TextView
            android:id="@+id/tvSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Press Start tracking"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start" />
            <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" />
            <Button android:id="@+id/btnRefresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Refresh OSM" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Garage detection" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvGarage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:text="No data" android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Floor estimate" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvFloor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:text="No data" android:textIsSelectable="true" android:textSize="14sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <EditText android:id="@+id/editAnchorLevel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Logical level" android:inputType="numberSigned" android:singleLine="true" />
            <Button android:id="@+id/btnReanchor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Re-anchor" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <EditText android:id="@+id/editFloorHeight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Floor height meters (default 3.0)" android:inputType="numberDecimal" android:singleLine="true" />
            <Button android:id="@+id/btnFloorHeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Apply" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Barometer" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvBarometer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:text="No data" android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Location / GNSS" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:text="No data" android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Motion sensors" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvMotion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:text="No data" android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Garage data source" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvData" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:text="No data" android:textIsSelectable="true" android:textSize="14sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Recent events" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/panel_background" android:fontFamily="monospace" android:minLines="5" android:text="No events" android:textIsSelectable="true" android:textSize="13sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:autoLink="web" android:text="Garage map data © OpenStreetMap contributors (ODbL) — https://www.openstreetmap.org/copyright" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" android:text="Research prototype. A floor estimate is probabilistic and must not be used for safety-critical navigation." android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
